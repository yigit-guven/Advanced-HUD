{
	"schemaVersion": 1,
	"id": "advanced-hud",
	"version": "${version}",
	"name": "Advanced Hud",
	"description": "Client side Minecraft mod that adds a highly customizable HUD that provides dynamic info on whatever you're looking at.",
	"authors": [
		"Yigit Guven"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/advancedhud",
		"sources": "https://github.com/yigit-guven/Advanced-Hud",
		"issues": "https://github.com/yigit-guven/Advanced-Hud/issues",
		"wiki": "https://github.com/yigit-guven/Advanced-Hud/wiki"
	},
	"license": "GPL-3.0",
	"icon": "assets/advanced-hud/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.yigit.advancedhud.AdvancedHudClient"
		],
		"modmenu": [
			"com.yigit.advancedhud.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "advanced-hud.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.1",
		"minecraft": "~26.1.2",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}